<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- MENU PILIH (MULTI-SELECT) -->
        <LinearLayout
            android:id="@+id/selectionToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2196F3"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone">
            
            <ImageButton
                android:id="@+id/btnCloseSelection"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />
                
            <TextView
                android:id="@+id/tvSelectedCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="0 terpilih"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- TOMBOL SALIN -->
            <ImageButton
                android:id="@+id/btnCopySelected"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_copy"
                app:tint="#FFFFFF" />

            <!-- TOMBOL PINDAH -->
            <ImageButton
                android:id="@+id/btnMoveSelected"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_move"
                app:tint="#FFFFFF" />
                
            <!-- TOMBOL GANTI NAMA -->
            <ImageButton
                android:id="@+id/btnRenameSelected"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_rename"
                app:tint="#FFFFFF" />
                
            <!-- TOMBOL PILIH SEMUA -->
            <ImageButton
                android:id="@+id/btnSelectAll"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_save"
                app:tint="#FFFFFF" />

            <!-- TOMBOL HAPUS -->
            <ImageButton
                android:id="@+id/btnDeleteSelected"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- HEADER PATH (TOMBOL ATAS) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryContainer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">
            <ImageButton
                android:id="@+id/btnTopBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="?attr/colorOnPrimaryContainer" />
            <TextView
                android:id="@+id/tvPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="/storage/emulated/0"
                android:textSize="13sp" />
            <ImageButton
                android:id="@+id/btnTopUp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_up"
                app:tint="?attr/colorOnPrimaryContainer" />
            <ImageButton
                android:id="@+id/btnTopNew"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add"
                app:tint="?attr/colorOnPrimaryContainer" />
            <ImageButton
                android:id="@+id/btnSort"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sort"
                app:tint="?attr/colorOnPrimaryContainer" />
        </LinearLayout>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_card"
            android:hint="Cari berkas..."
            android:inputType="text"
            android:padding="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="100dp" />
    </LinearLayout>

    <!-- FAB TEMPEL (MUNCUL SAAT SALIN/PINDAH) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPaste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Tempel"
        android:visibility="gone" 
        app:backgroundTint="#4CAF50"
        app:srcCompat="@drawable/ic_save" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>