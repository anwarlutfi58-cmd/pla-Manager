<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER PATH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryContainer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">
            <ImageButton
                android:id="@+id/btnTopBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="?attr/colorOnPrimaryContainer" />
            <TextView
                android:id="@+id/tvPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="/storage/emulated/0"
                android:textSize="13sp" />
            
            <!-- INDIKATOR PENYIMPANAN -->
            <TextView
                android:id="@+id/tvStorageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0% DIGUNAKAN"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>
            
            <TextView
                android:id="@+id/btnSelectAllTop"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Pilih Semua"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- TOMBOL BUAT FOLDER BARU (SELALU MUNCUL) -->
            <ImageButton
                android:id="@+id/btnTopNew"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add"
                android:contentDescription="Buat Folder Baru"
                app:tint="?attr/colorOnPrimaryContainer" />

            <!-- TOMBOL SORTIR/URUTKAN -->
            <ImageButton
                android:id="@+id/btnSort"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sort"
                android:contentDescription="Urutkan"
                app:tint="?attr/colorOnPrimaryContainer" />
        </LinearLayout>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_card"
            android:hint="Cari berkas..."
            android:inputType="text"
            android:padding="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <!-- MENU AKSI BAWAH (MUNCUL SAAT DICENTANG) -->
        <LinearLayout
            android:id="@+id/selectionToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E2A38"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">
            
            <LinearLayout android:id="@+id/btnCopySelected" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_copy" app:tint="#FFFFFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salin" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnMoveSelected" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_move" app:tint="#FFFFFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pindahkan" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnRenameSelected" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_rename" app:tint="#FFFFFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ganti Nama" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnDeleteSelected" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_delete" app:tint="#FFFFFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hapus" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnMoreActions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_more" app:tint="#FFFFFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lainnya" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPaste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Tempel"
        android:visibility="gone" 
        app:backgroundTint="#4CAF50"
        app:srcCompat="@drawable/ic_save" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>