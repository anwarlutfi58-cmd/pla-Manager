<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ========================================== -->
        <!-- BAGIAN 1: STATISTIK PENYIMPANAN (ALA FILE MANAGER +) -->
        <!-- ========================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Penyimpanan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="1"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/cardInternal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_save" app:tint="#4CAF50"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Memori Internal" android:textSize="12sp" android:textColor="#333333" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tvInternalSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 GB / 0 GB" android:textSize="10sp" android:textColor="#777777"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSdCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_save" app:tint="#2196F3"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kartu SD" android:textSize="12sp" android:textColor="#333333" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tvSdSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 GB / 0 GB" android:textSize="10sp" android:textColor="#777777"/>
            </LinearLayout>

        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kategori"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="3">

            <LinearLayout
                android:id="@+id/cardImages"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_gallery" app:tint="#9C27B0"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gambar" android:textSize="12sp" android:textColor="#333333" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tvImageStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 MB (0)" android:textSize="10sp" android:textColor="#777777"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_lock_silent_mode_off" app:tint="#4CAF50"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Audio" android:textSize="12sp" android:textColor="#333333" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tvAudioStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 MB (0)" android:textSize="10sp" android:textColor="#777777"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardVideos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_media_play" app:tint="#F44336"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Video" android:textSize="12sp" android:textColor="#333333" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tvVideoStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 MB (0)" android:textSize="10sp" android:textColor="#777777"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardDocuments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#FF9800"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dokumen" android:textSize="12sp" android:textColor="#333333" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tvDocStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 MB (0)" android:textSize="10sp" android:textColor="#777777"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardDownloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_directions" app:tint="#00BCD4"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Download" android:textSize="12sp" android:textColor="#333333" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tvDownloadStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 MB (0)" android:textSize="10sp" android:textColor="#777777"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardApps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_manage" app:tint="#4CAF50"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aplikasi" android:textSize="12sp" android:textColor="#333333" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tvAppStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 MB (0)" android:textSize="10sp" android:textColor="#777777"/>
            </LinearLayout>

        </GridLayout>

        <!-- ========================================== -->
        <!-- BAGIAN 2: MENU ASLI ANDA DIKEMBALIKAN -->
        <!-- ========================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fitur Lainnya"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnFileManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buka File Manager (Semua File)"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="12dp"/>

        <!-- Saya biarkan tombol di bawah ini sebagai tempat menu asli Anda (Cloud, Github, Editor) -->
        <!-- Jika Anda punya tombol menu asli seperti Editor, Cloud, atau Github, tambahkan di sini -->
        
    </LinearLayout>
</ScrollView>