<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout android:id="@+id/moreShare" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_share" app:tint="#4CAF50" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Bagikan" android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/moreShortcut" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_shortcut" app:tint="#2196F3" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Tambahkan ke layar Beranda" android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/moreCompress" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_compress" app:tint="#FF9800" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Kompresikan (ZIP)" android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/moreOpenWith" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_open_with" app:tint="#9C27B0" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Buka dengan" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>