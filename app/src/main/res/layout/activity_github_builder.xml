<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PLA GitHub"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:padding="12dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <!-- ========================================== -->
        <!-- LAYAR 1: LOGIN TOKEN (Jika belum punya token) -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/layoutLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masukkan Personal Access Token GitHub Anda:"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ghp_xxxxxxxxxxxx..."
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:inputType="textPassword"/>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Simpan &amp; Login"
                android:backgroundTint="#0D47A1"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnBuatTokenWeb"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Buat Token di Web GitHub"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- ========================================== -->
        <!-- LAYAR 2: MENU UTAMA (Jika sudah login) -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/layoutMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button android:id="@+id/btnMenu1" android:layout_width="match_parent" android:layout_height="60dp" android:text="1. Repositori saya" android:textAlignment="textStart" android:paddingStart="16dp" android:backgroundTint="#0D47A1" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnMenu2" android:layout_width="match_parent" android:layout_height="60dp" android:text="2. Cari repositori" android:textAlignment="textStart" android:paddingStart="16dp" android:backgroundTint="#0D47A1" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnMenu3" android:layout_width="match_parent" android:layout_height="60dp" android:text="3. Lihat rilis repositori" android:textAlignment="textStart" android:paddingStart="16dp" android:backgroundTint="#0D47A1" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnMenu4" android:layout_width="match_parent" android:layout_height="60dp" android:text="4. Buat repositori baru" android:textAlignment="textStart" android:paddingStart="16dp" android:backgroundTint="#0D47A1" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnMenu5" android:layout_width="match_parent" android:layout_height="60dp" android:text="5. Situs web (GitHub Pages)" android:textAlignment="textStart" android:paddingStart="16dp" android:backgroundTint="#0D47A1" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnMenu6" android:layout_width="match_parent" android:layout_height="60dp" android:text="6. Salin token saya" android:textAlignment="textStart" android:paddingStart="16dp" android:backgroundTint="#0D47A1" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnMenu7" android:layout_width="match_parent" android:layout_height="60dp" android:text="7. Buat token di web" android:textAlignment="textStart" android:paddingStart="16dp" android:backgroundTint="#0D47A1" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnMenu8" android:layout_width="match_parent" android:layout_height="60dp" android:text="8. Pengaturan bangun APK" android:textAlignment="textStart" android:paddingStart="16dp" android:backgroundTint="#0D47A1" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnMenu9" android:layout_width="match_parent" android:layout_height="60dp" android:text="9. Tema tampilan" android:textAlignment="textStart" android:paddingStart="16dp" android:backgroundTint="#0D47A1" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnMenu10" android:layout_width="match_parent" android:layout_height="60dp" android:text="10. Keluar akun" android:textAlignment="textStart" android:paddingStart="16dp" android:backgroundTint="#B71C1C" android:textColor="#FFFFFF" android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <Button android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="60dp" android:text="Kembali" android:backgroundTint="#757575" android:textColor="#FFFFFF"/>
    </LinearLayout>
</ScrollView>