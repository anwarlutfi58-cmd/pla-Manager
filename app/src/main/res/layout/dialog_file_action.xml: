<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:weightSum="5">

    <LinearLayout android:id="@+id/actionCopy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:gravity="center" android:orientation="vertical" android:padding="8dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_copy" app:tint="#4CAF50" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Salin" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/actionMove" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:gravity="center" android:orientation="vertical" android:padding="8dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_move" app:tint="#FF9800" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Pindahkan" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/actionRename" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:gravity="center" android:orientation="vertical" android:padding="8dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_rename" app:tint="#2196F3" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ganti Nama" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/actionDelete" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:gravity="center" android:orientation="vertical" android:padding="8dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_delete" app:tint="#F44336" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Hapus" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/actionMore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:gravity="center" android:orientation="vertical" android:padding="8dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_more" app:tint="#9E9E9E" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Lainnya" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>